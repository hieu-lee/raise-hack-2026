{
  "name": "driftradar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "driftradar": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "vitest run",
    "validate:fixture": "tsx src/cli/index.ts validate --config fixtures/config/valid.json",
    "driftradar": "node dist/cli/index.js",
    "demo:backend": "node scripts/demo-backend.mjs",
    "demo:frontend": "node dashboard/scripts/demo-frontend.mjs",
    "demo:record": "node dashboard/scripts/record-demo.mjs",
    "demo:serve": "node scripts/serve-latest.mjs",
    "smoke:frontend": "playwright test dashboard/tests/browser",
    "sample-app": "node scripts/serve-sample-app.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@openai/codex-sdk": "^0.142.5",
    "commander": "^15.0.0",
    "culori": "^4.0.2",
    "express": "^5.2.1",
    "fast-glob": "^3.3.3",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.16",
    "postcss-safe-parser": "^7.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.0",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.6.0",
    "prettier": "^3.9.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
  }
}
